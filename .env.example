# Credenciais da conta X usada pela coleta com twikit.
# Recomendamos usar uma conta SECUNDÁRIA — a API é não-oficial e existe
# risco de bloqueio.
#
# Como usar:
#   1. Copie este arquivo:  cp .env.example .env
#   2. Preencha os valores abaixo.
#   3. Rode:  python src/collect.py
#
# Após o primeiro login bem-sucedido, os cookies de sessão são salvos em
# .twikit_cookies.json (gitignored). Execuções seguintes reutilizam o
# cookie e não exigem novo login.

X_USERNAME=seu_handle_sem_arroba
X_EMAIL=seu_email@exemplo.com
X_PASSWORD=sua_senha
